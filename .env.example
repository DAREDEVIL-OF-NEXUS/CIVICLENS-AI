# ==========================================
# CIVICLENS AI - GLOBAL CONFIGURATION
# ==========================================

# 1. APPLICATION
CIVICLENS_APP_NAME="CivicLens AI API"
CIVICLENS_APP_VERSION="1.0.0"
CIVICLENS_ENV="development" # Change to production in deployment

# 2. DATABASE (PostgreSQL / PostGIS / pgvector recommended)
# For local dev without Postgres, leave as sqlite.
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DB_NAME]"
# DATABASE_URL="sqlite:///./civiclens.db"

# 3. AUTHENTICATION & SECURITY
CIVICLENS_ADMIN_USERNAME="admin"
CIVICLENS_ADMIN_PASSWORD="civiclens123"
CIVICLENS_AUTH_SECRET="[PLACEHOLDER_JWT_SECRET_KEY]"
CIVICLENS_AUTH_TTL_HOURS=12

# 4. AI PIPELINE & API KEYS (LLM, Vision, Embeddings)
GROQ_API_KEY="[PLACEHOLDER_GROQ_API_KEY]"
GEMINI_API_KEY="[PLACEHOLDER_GEMINI_API_KEY]"
OPENAI_API_KEY="[PLACEHOLDER_OPENAI_API_KEY]"

# 5. LOCATION & MAPS
OLA_MAPS_API_KEY="[PLACEHOLDER_OLA_MAPS_API_KEY]"
GOOGLE_MAPS_API_KEY="[PLACEHOLDER_GOOGLE_MAPS_API_KEY]"

# 6. EXTERNAL COMMUNICATIONS (SMS/OTP/Email)
FAST2SMS_API_KEY="[PLACEHOLDER_FAST2SMS_API_KEY]"
TWILIO_ACCOUNT_SID="[PLACEHOLDER_TWILIO_SID]"
TWILIO_AUTH_TOKEN="[PLACEHOLDER_TWILIO_TOKEN]"

CIVICLENS_EMAIL_ENABLED="false"
CIVICLENS_EMAIL_FROM="no-reply@civiclens.local"
CIVICLENS_ADMIN_ALERT_EMAIL="admin@civiclens.local"

# 7. FRONTEND CONFIG
CIVICLENS_FRONTEND_URL="http://127.0.0.1:5173"
VITE_API_BASE_URL="http://127.0.0.1:8000"
